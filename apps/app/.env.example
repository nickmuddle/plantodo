# Copy to .env.local and fill in. For a local stack, `npx supabase status`
# prints both values (API URL and publishable key).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=

# Optional: the public web address of the app, used to build invite links.
# Defaults to the current address on web and the app's own link scheme on phones.
EXPO_PUBLIC_APP_URL=
